{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aivax-toys",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // v2 removes the per-IP RateLimiter: usage is now billed to each visitor's own AIVAX account.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RateLimiter"] },
    { "tag": "v2", "deleted_classes": ["RateLimiter"] }
  ],
  "routes": [{ "pattern": "toys.aivax.net", "custom_domain": true }],
  "observability": { "enabled": true }
}
